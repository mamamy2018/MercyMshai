# Copy to .env for local development only. Never commit .env.
# In production, load these from your host's secrets manager.

# Use a restricted key (rk_test_... / rk_live_...) with only these permissions:
#   Checkout Sessions: Write, Prices: Read
# `npm run seed` additionally needs Products: Write and Prices: Write; run it with
# a separate key rather than giving the web server those permissions.
STRIPE_API_KEY=rk_test_replace_me

# From `stripe listen --forward-to localhost:4242/webhook` (local)
# or the webhook endpoint you create in the Dashboard (production).
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public URL of this site, used for Checkout success/cancel redirects.
PUBLIC_URL=http://localhost:4242
PORT=4242
